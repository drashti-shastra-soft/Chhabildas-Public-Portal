@{
    ViewBag.Title = "Buy Premium Bedsheets, Blankets, and Home Linen – Chhabildas Enterprise";
    ViewBag.MetaDescription = "Explore a wide range of bedsheets, blankets, and home linen at Chhabildas Enterprise. Quality products for homes, hotels, and hospitals. Shop now for exclusive deals!";
    ViewBag.MetaKeywords = "Bedsheets, Home Linen, Hotel Linen, Hospital Linen, Blankets, Comforters, Pillows";
}

<div class="HomeSlider" id="SliderSection">
    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <img src="~/images/slider/homelinen1.jpg" />
                <div class="captionBox">
                    <h3>Home Linen</h3>
                    <p>Indulge in comfort and elegance with our premium Home Linen collection. From soft bed sheets and cozy comforters to warm blankets and plush pillows, we offer everything to enhance your living space. Experience unmatched quality with our Solapuri Charsa, towels, cushions, and mattress protectors—designed for superior comfort and durability.</p>
                </div>
            </div>
            <div class="swiper-slide">
                <img src="~/images/slider/hotellinen1.jpg" />
                <div class="captionBox">
                    <h3>Hotel Linen</h3>
                    <p>Upgrade your hospitality with our finest Hotel Linen collection. From soft bed sheets, plush mattresses, pillows, and duvets to protectors, towels, bath mats, and elegant bed runners, we ensure superior comfort and durability.</p>
                </div>
            </div>
            <div class="swiper-slide">
                <img src="~/images/slider/HospitalLinen1.jpg" />
                @* <img src="~/images/hospitallinenslider.jpg" /> *@
                <div class="captionBox">
                    <h3>Hospital Linen</h3>
                    <p>Our Hospital Linen range includes premium bed sheets, pillow covers, blankets, pillow protectors, gowns, aprons, uniforms, OT scrubs, and linen. Designed for comfort, hygiene, and durability, our products meet the highest standards to ensure the well-being of both patients and healthcare professionals.</p>
                </div>
            </div>
        </div>
        <div class="autoplay-progress">
            <svg viewBox="0 0 48 48">
                <circle cx="24" cy="24" r="20"></circle>
            </svg>
            <span></span>
        </div>
        @* <div class="swiper-pagination"></div> *@
    </div>
</div>

